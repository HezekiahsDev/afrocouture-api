# AfroCouture AI API — Production Deployment Configuration
# Target for `pnpm deploy:production` (or `pnpm deploy --production`)
DEPLOY_HOST=user@your-production-server-ip
DEPLOY_PATH=/home/user/projects/afrocouture-api
DEPLOY_BRANCH=main
DEPLOY_SSH_PORT=22
APP_NAME=afrocouture-api
APP_PORT=3001
RUN_TESTS=1
SYNC_ENV=1
ENV_SOURCE=.env
