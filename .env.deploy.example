# AfroCouture AI API — QA / Staging Deployment Configuration
# Default target for `pnpm deploy` (or `pnpm deploy:qa`)
DEPLOY_HOST=user@your-staging-server-ip
DEPLOY_PATH=/home/user/projects/afrocouture-api
DEPLOY_BRANCH=main
DEPLOY_SSH_PORT=22
APP_NAME=qa-afrocouture-api
APP_PORT=3001
RUN_TESTS=1
SYNC_ENV=1
ENV_SOURCE=.env.qa
