PORT=3001
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=afrocouture
DB_PASSWORD=afrocouture_dev
DB_NAME=afrocouture

# Cache & Pub-Sub (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_pass

# Auth & JWT
JWT_SECRET=afrocouture_dev_jwt_secret_key_super_secure_2026
JWT_REFRESH_SECRET=afrocouture_dev_refresh_secret_key_super_secure_2026
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Google Vertex AI (Imagen)
VERTEX_AI_PROJECT_ID=afrocouture-dev
VERTEX_AI_LOCATION=us-central1


# Web app origin(s) allowed by CORS — comma-separated, e.g. https://afrocouture.ai,https://qa.afrocouture.ai
FRONTEND_URL=

# Mail (SMTP) — same setup as dali-be. MAIL_USER/MAIL_PASS are primary; MAIL_USERNAME/MAIL_PASSWORD also accepted.
# Leave MAIL_HOST empty locally to print emails (including OTP codes) to the console instead of sending.
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM_NAME=AfroCouture AI
MAIL_FROM_EMAIL=

# Cloudinary (file uploads: KYC documents, CAC certificates, fit photos, fabric images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=afrocouture
