PORT=3001
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=afrocouture
DB_PASSWORD=afrocouture_dev
DB_NAME=afrocouture

# Cache & Pub-Sub (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_pass

# Auth & JWT
JWT_SECRET=afrocouture_dev_jwt_secret_key_super_secure_2026
JWT_REFRESH_SECRET=afrocouture_dev_refresh_secret_key_super_secure_2026
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Google Vertex AI (Imagen) — AI Design Studio. Leave the project or credentials empty to disable it (503).
VERTEX_AI_PROJECT_ID=
VERTEX_AI_LOCATION=us-central1
VERTEX_IMAGEN_MODEL=imagen-3.0-generate-002
# Service-account key JSON on one line (role: Vertex AI User), or set GOOGLE_APPLICATION_CREDENTIALS to a key file path.
GOOGLE_APPLICATION_CREDENTIALS_JSON=
# Designs each person can generate per UTC day.
AI_DAILY_LIMIT=20


# Web app origin(s) allowed by CORS — comma-separated, e.g. https://afrocouture.ai,https://qa.afrocouture.ai
FRONTEND_URL=

# Mail (SMTP) — same setup as dali-be. MAIL_USER/MAIL_PASS are primary; MAIL_USERNAME/MAIL_PASSWORD also accepted.
# Leave MAIL_HOST empty locally to print emails (including OTP codes) to the console instead of sending.
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM_NAME=AfroCouture AI
MAIL_FROM_EMAIL=

# Cloudinary (file uploads: KYC documents, CAC certificates, fit photos, fabric images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=afrocouture

# Payments (Paystack) — sk_test_… for testing, sk_live_… in production.
# Set the webhook URL in the Paystack dashboard to https://<api-domain>/payments/paystack/webhook
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
# Where Paystack returns the customer after paying; default: <first FRONTEND_URL>/orders/payment-callback
PAYMENT_CALLBACK_URL=
# Charged to the customer on top of workmanship + delivery + fabric (percent)
PLATFORM_FEE_PERCENT=0
# Delivered orders the customer neither approves nor disputes are completed (and the tailor paid) after this many days
AUTO_APPROVE_DAYS=7

# Redis logical database (optional, default 0)
# REDIS_DB=0

# ── Test / local-development only — never set these in production ──
# CLOUDINARY_UPLOAD_PREFIX=   # send uploads to a local Cloudinary stand-in
# VERTEX_API_BASE_URL=        # send Imagen calls to a local stand-in
# VERTEX_ACCESS_TOKEN=        # fixed bearer token instead of the service account
# AUTO_APPROVE_CHECK_MS=      # how often the auto-approve job runs (default hourly)

# ── Operations: logs, alerts, backups ──
# json = one JSON object per line (default when NODE_ENV=production); pretty = coloured text
LOG_FORMAT=
# Where crash / 500 / failed-payout alerts go: comma-separated emails (sent with the MAIL_* SMTP)
ALERT_EMAIL=
# And/or a Slack or Discord incoming-webhook URL
ALERT_WEBHOOK_URL=
# The same alert is sent at most once per this many minutes (default 15)
ALERT_THROTTLE_MINUTES=15
# Database backups (scripts/backup-db.sh): where dumps go and how many days to keep
BACKUP_DIR=
BACKUP_KEEP_DAYS=14
# Optional off-server copy with rclone, e.g. b2:afrocouture-backups (configure rclone first)
BACKUP_RCLONE_REMOTE=

# Shown in account suspension emails (e.g. support@afrocouture.ai)
SUPPORT_EMAIL=
